+/* This exact one-stage program computes interpolated diffuse * texture.
+ * Keep texture sampling, triangle coverage, depth, alpha, and framebuffer
+ * writes in the reference path; specialize only the combiner arithmetic. */
+static int xf_diffuse_texture_mul_gate(const XfTri *T)
+{
+    const Nv2aCombiner *rc = &s_gpu.rc;
+    return T->use_rc && !s_gpu.alpha_test && rc->control == 0x00011101
+        && rc->stage_program == 0x00000001
+        && rc->color_icw[0] == 0xC4C80000
+        && rc->alpha_icw[0] == 0xD4D81010
+        && rc->color_ocw[0] == 0x000000C0
+        && rc->alpha_ocw[0] == 0x000000C0
+        && rc->final0 == 0x200C0000
+        && rc->final1 == 0x00001C80;
+}
+
+/* The measured format-0x0E fade configures no texture stage and this exact
+ * combiner returns interpolated diffuse color unchanged. Preserve per-pixel
+ * coverage, depth, and blending while skipping the generic combiner program. */
+static int xf_diffuse_passthrough_gate(const XfTri *T)
+{
+    const Nv2aCombiner *rc = &s_gpu.rc;
+    const Texture *tex = &s_gpu.texs[0];
+    return T->use_rc && T->textured && tex->valid && tex->color == 0x0E
+        && tex->width == 512 && tex->height == 512
+        && tex->filter == 0x02022000 && tex->addr_u == 1 && tex->addr_v == 1
+        && !s_gpu.alpha_test && s_gpu.blend_enable
+        && s_gpu.blend_sfactor == 0x0302 && s_gpu.blend_dfactor == 0x0303
+        && s_gpu.blend_equation == 0x8006 && s_gpu.depth_test
+        && s_gpu.depth_func == 0x203 && !s_gpu.depth_mask
+        && !s_gpu.zpass_enable && s_gpu.color_mask == 0x01010101u
+        && rc->control == 0x00011101 && rc->stage_program == 0
+        && rc->color_icw[0] == 0xC4200000
+        && rc->alpha_icw[0] == 0xD4301010
+        && rc->color_ocw[0] == 0x000000C0
+        && rc->alpha_ocw[0] == 0x000000C0
+        && rc->final0 == 0x200C0000 && rc->final1 == 0x00001C80;
+}
