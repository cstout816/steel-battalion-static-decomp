+static int vp_create_host_buffer(VkDeviceSize size, VkBufferUsageFlags usage,
+                                VkBuffer *buffer, VkDeviceMemory *memory,
+                                void **mapped)
+{
+    VkBufferCreateInfo buffer_info;
+    VkMemoryRequirements requirements;
+    VkMemoryAllocateInfo allocation;
+    uint32_t type;
+    VkResult result;
+
+    memset(&buffer_info, 0, sizeof(buffer_info));
+    buffer_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    buffer_info.size = size;
+    buffer_info.usage = usage;
+    buffer_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    result = vkCreateBuffer(s_vp.device, &buffer_info, NULL, buffer);
+    if (result != VK_SUCCESS)
+        return vp_error("creating NV2A buffer", result);
+    vkGetBufferMemoryRequirements(s_vp.device, *buffer, &requirements);
+    type = vp_memory_type(requirements.memoryTypeBits,
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT
+        | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (type == UINT32_MAX) {
+        fprintf(stderr, "[Vulkan] no coherent host-visible NV2A memory\n");
+        return 0;
+    }
+    memset(&allocation, 0, sizeof(allocation));
+    allocation.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+    allocation.allocationSize = requirements.size;
+    allocation.memoryTypeIndex = type;
+    result = vkAllocateMemory(s_vp.device, &allocation, NULL, memory);
+    if (result != VK_SUCCESS)
+        return vp_error("allocating NV2A buffer memory", result);
+    result = vkBindBufferMemory(s_vp.device, *buffer, *memory, 0);
+    if (result != VK_SUCCESS)
+        return vp_error("binding NV2A buffer memory", result);
+    result = vkMapMemory(s_vp.device, *memory, 0, size, 0, mapped);
+    if (result != VK_SUCCESS)
+        return vp_error("mapping NV2A buffer memory", result);
+    return 1;
+}
