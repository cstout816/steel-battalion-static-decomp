diff --git a/src/video/nv2a_textured.hlsl b/src/video/nv2a_textured.hlsl
new file mode 100644
index 0000000..9a99940
--- /dev/null
+++ b/src/video/nv2a_textured.hlsl
@@ -0,0 +1,32 @@
+struct VertexInput {
+    float2 position : POSITION;
+    float4 color : COLOR;
+    float2 uv : TEXCOORD0;
+};
+
+struct VertexOutput {
+    float4 position : SV_POSITION;
+    float4 color : COLOR;
+    float2 uv : TEXCOORD0;
+};
+
+cbuffer DrawParameters : register(b0) {
+    float4 target_extent;
+};
+
+VertexOutput main_vs(VertexInput input) {
+    VertexOutput output;
+    float2 ndc = float2(2.0 * input.position.x / target_extent.x - 1.0,
+                        2.0 * input.position.y / target_extent.y - 1.0);
+    output.position = float4(ndc, 0.0, 1.0);
+    output.color = input.color;
+    output.uv = input.uv;
+    return output;
+}
+
+Texture2D<float4> source_texture : register(t0);
+SamplerState source_sampler : register(s0);
+
+float4 main_ps(VertexOutput input) : SV_TARGET {
+    return saturate(source_texture.Sample(source_sampler, input.uv) * input.color);
+}
