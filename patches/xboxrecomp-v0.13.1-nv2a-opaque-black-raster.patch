+    uint32_t zpass;
+} XfCount;
+
+/* Runtime modes for the exact Steel Battalion startup format-0x12 pass. */
+static int xf_opaque_black_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        if (getenv("RECOMP_VALIDATE_OPAQUE_BLACK_RASTER")) mode = 1;
+        else if (getenv("RECOMP_DISABLE_OPAQUE_BLACK_RASTER")) mode = 0;
+        else mode = 2;
+    }
+    return mode;
+}
+
+static int xf_opaque_black_gate(const XfTri *T)
+{
+    const Nv2aVshOutput *v[3] = {T->va, T->vb, T->vc};
+    float tex[4][4] = {{0}}, fog[4] = {0}, out[4];
+    uint32_t i, j;
+
+    if (!xf_opaque_black_mode() || !T->use_rc || !T->textured
+        || (s_gpu.xf_mode & 3) != 2 || !s_gpu.texs[0].valid
+        || s_gpu.texs[0].color != 0x12
+        || s_gpu.texs[0].width != 1024 || s_gpu.texs[0].height != 1024
+        || s_gpu.blend_enable || s_gpu.alpha_test || s_gpu.fog_enable
+        || !s_gpu.depth_test || s_gpu.depth_func != 0x203 || s_gpu.depth_mask
+        || s_gpu.zpass_enable || s_gpu.color_mask != 0x01010101u
+        || s_gpu.texs[0].filter != 0x02022000
+        || !s_gpu.rc_seen || s_gpu.rc.control != 0x00011101
+        || s_gpu.rc.stage_program != 0
+        || s_gpu.rc.color_icw[0] != 0xC4200000
+        || s_gpu.rc.alpha_icw[0] != 0xD4301010
+        || s_gpu.rc.color_ocw[0] != 0x000000C0
+        || s_gpu.rc.alpha_ocw[0] != 0x000000C0
+        || s_gpu.rc.final0 != 0x200C0000
+        || s_gpu.rc.final1 != 0x00001C80
+        || surface_bpp() != 4 || s_gpu.pitch != 640u * 4u
+        || s_gpu.clip_x != 0 || s_gpu.clip_y != 0
+        || s_gpu.clip_w != 640 || s_gpu.clip_h != 480)
+        return 0;
+
+    for (i = 0; i < 3; i++) {
+        if ((v[i]->pos[0] != 0.0f && v[i]->pos[0] != 640.0f)
+            || (v[i]->pos[1] != 0.0f && v[i]->pos[1] != 480.0f)
+            || v[i]->pos[2] != 0.0f || v[i]->pos[3] != 1.0f
+            || v[i]->d0[0] != 0.0f || v[i]->d0[1] != 0.0f
+            || v[i]->d0[2] != 0.0f || v[i]->d0[3] != 1.0f)
+            return 0;
+        for (j = 0; j < 4; j++)
+            if (v[i]->d1[j] != T->va->d1[j])
+                return 0;
+        if (v[i]->tex[0][0] != 0.0f || v[i]->tex[0][1] != 0.0f
+            || v[i]->tex[0][2] != 0.0f || v[i]->tex[0][3] != 1.0f)
+            return 0;
+    }
+
+    /* Verify both texture extremes with the actual interpolated constants.
+     * Validation mode also compares every covered reference fragment. */
+    tex[0][3] = 1.0f;
+    nv2a_rc_eval(&s_gpu.rc, T->va->d0, T->va->d1, fog,
+                 (const float (*)[4])tex, out);
+    if (pack_color(out) != 0xFF000000u)
+        return 0;
+    tex[0][0] = tex[0][1] = tex[0][2] = tex[0][3] = 1.0f;
+    nv2a_rc_eval(&s_gpu.rc, T->va->d0, T->va->d1, fog,
+                 (const float (*)[4])tex, out);
+    return pack_color(out) == 0xFF000000u;
+}
 
