+    def test_locked_xadd_branch_uses_atomic_result_flags(self):
+        xadd = Instruction(0, 3, "lock xadd", "dword ptr [ecx], edx", "f00fc111")
+        xadd.operands = [_mem_ecx(), Operand(type="reg", reg="edx")]
+        jne = Instruction(3, 2, "jne", "0x20", "751b")
+        jne.jump_target = 0x20
+        generated, _ = lift_basic_block(
+            Lifter(), BasicBlock(start=0, instructions=[xadd, jne]))
+        generated = chr(10).join(generated)
+        self.assertIn("_fa = _old + _src;", generated)
+        self.assertIn("if ((_fa != 0))", generated)
+        self.assertNotIn("if (_flags", generated)
