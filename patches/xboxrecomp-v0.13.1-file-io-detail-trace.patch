+/* Opt-in bounded completion telemetry for copy-path diagnosis. Path mapping
+ * comes from the separate lifecycle trace; this records the result for the
+ * same guest handle token without changing the I/O call or completion path. */
+static void bridge_trace_file_io(const char *operation, uint32_t token,
+        HANDLE handle, uint32_t info_class, int offset_valid,
+        int64_t offset, uint32_t length, uint32_t information,
+        uint32_t ios_status, uint32_t native_status, uint32_t guest_status)
+{
+    static volatile LONG enabled = -1;
+    static volatile LONG trace_count;
+    LONG n;
+    const char *setting;
+
+    if (enabled < 0) {
+        setting = getenv("RECOMP_FILE_IO_DETAIL_TRACE");
+        InterlockedCompareExchange(&enabled,
+                setting && *setting && *setting != '0', -1);
+    }
+    if (!enabled)
+        return;
+
+    n = InterlockedIncrement(&trace_count);
+    if (n > 8192)
+        return;
+
+    if (offset_valid) {
+        fprintf(stderr,
+                "[FILE-IO] tick_ms=%llu tid=%u n=%ld op=%s token=%08X "
+                "host=%p caller=%08X class=%08X offset=%lld length=%u "
+                "info=%u ios=0x%08X nt=0x%08X guest=0x%08X\n",
+                (unsigned long long)GetTickCount64(),
+                (unsigned)GetCurrentThreadId(), n, operation, token, handle,
+                g_xbox_kernel_caller, info_class, (long long)offset, length,
+                information, ios_status, native_status, guest_status);
+    } else {
+        fprintf(stderr,
+                "[FILE-IO] tick_ms=%llu tid=%u n=%ld op=%s token=%08X "
+                "host=%p caller=%08X class=%08X offset=seq length=%u "
+                "info=%u ios=0x%08X nt=0x%08X guest=0x%08X\n",
+                (unsigned long long)GetTickCount64(),
+                (unsigned)GetCurrentThreadId(), n, operation, token, handle,
+                g_xbox_kernel_caller, info_class, length, information,
+                ios_status, native_status, guest_status);
+    }
+}
