-    t_guest_thread = 1;
-    if (guest_cpu_enabled() && !t_guest_held) {
-        EnterCriticalSection(&g_guest_cpu);
-        t_guest_held = 1;
-    }
+    xbox_GuestCpuJoin();
@@ -9387,5 +10200 @@ void guest_cpu_part(void)
