+uint32_t mcpx_apu_dsp_engine_run_frame(DSPState *dsp, uint32_t cycle_budget)
+{
+#ifdef MCPX_APU_USE_DSP56300
+    if (!dsp || !dsp->jit || cycle_budget == 0 ||
+        cycle_budget > (uint32_t)INT32_MAX) {
+        return 0;
+    }
+    dsp->interrupts |= DSP_INTERRUPT_START_FRAME;
+    dsp->host_halt_requested = false;
+    dsp56300_set_halt_requested((Dsp56300Jit *)dsp->jit, false);
+    dsp56300_set_cycle_count((Dsp56300Jit *)dsp->jit, 0);
+    dsp56300_run((Dsp56300Jit *)dsp->jit, (int32_t)cycle_budget);
+    if (dsp->host_halt_requested) {
+        dsp56300_set_halt_requested((Dsp56300Jit *)dsp->jit, true);
+    }
+    dsp->core.cycle_count = dsp56300_cycle_count((Dsp56300Jit *)dsp->jit);
+    return dsp->core.cycle_count;
+#else
+    (void)dsp;
+    (void)cycle_budget;
+    return 0;
+#endif
+}
