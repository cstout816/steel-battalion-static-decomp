+static uint32_t dsp_peripheral_read(void *opaque, uint32_t address)
+{
+    DSPState *dsp = (DSPState *)opaque;
+    if (!dsp) {
+        return 0x000ABABAu;
+    }
+    switch (address) {
+    case 0xFFFFB3u:
+        return 0;
+    case 0xFFFFC5u:
+        return dsp->interrupts | (dsp->dma.eol ? DSP_INTERRUPT_DMA_EOL : 0u);
+    case 0xFFFFD4u:
+        return dsp->dma.next_block;
+    case 0xFFFFD5u:
+        return dsp->dma.start_block;
+    case 0xFFFFD6u:
+        return dsp->dma.control;
+    case 0xFFFFD7u:
+        return dsp->dma.configuration;
+    default:
+        return 0x000ABABAu;
+    }
+}
+
+static void dsp_peripheral_write(void *opaque, uint32_t address, uint32_t value)
+{
+    DSPState *dsp = (DSPState *)opaque;
+    if (!dsp) {
+        return;
+    }
+    switch (address) {
+    case 0xFFFFC4u:
+        dsp->host_halt_requested = (value & 1u) != 0;
+        break;
+    case 0xFFFFC5u:
+        dsp->interrupts &= ~value;
+        if (value & DSP_INTERRUPT_DMA_EOL) {
+            dsp->dma.eol = false;
+        }
+        break;
+    case 0xFFFFD4u:
+        dsp->dma.next_block = value;
+        break;
+    case 0xFFFFD5u:
+        dsp->dma.start_block = value;
+        break;
+    case 0xFFFFD6u:
+        dsp->dma.control = value;
+        break;
+    case 0xFFFFD7u:
+        dsp->dma.configuration = value;
+        break;
+    default:
+        break;
+    }
+}
