+static int pmc_irq_line_asserted(const NV2AState *d)
+{
+    uint32_t pending = d->pmc.pending_interrupts;
+    uint32_t enabled = d->pmc.enabled_interrupts;
+    int hardware_pending = (pending & ~NV_PMC_INTR_0_SOFTWARE) != 0;
+    int software_pending = (pending & NV_PMC_INTR_0_SOFTWARE) != 0;
+
+    return (hardware_pending && (enabled & NV_PMC_INTR_EN_0_HARDWARE))
+        || (software_pending && (enabled & NV_PMC_INTR_EN_0_SOFTWARE));
+}
 
