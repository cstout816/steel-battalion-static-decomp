index 0bd4ebd..f32c11e 100644
--- a/src/apu/CMakeLists.txt
+++ b/src/apu/CMakeLists.txt
@@ -13,6 +13,78 @@ add_library(xbox_apu STATIC
     apu_xaudio2.c
 )
 
+# The pinned DSP56300 FFI is an optional core-lifecycle integration step.
+# GP/EP MMIO, firmware bootstrap, cycle scheduling, and DMA are not yet wired,
+# so leave it disabled until the complete behavior is implemented and tested.
+option(XBOXRECOMP_ENABLE_DSP56300 "Create MCPX GP/EP engines with the MIT DSP56300 FFI" OFF)
+if(XBOXRECOMP_ENABLE_DSP56300)
+    if(NOT WIN32 OR NOT MSVC)
+        message(FATAL_ERROR "The DSP56300 FFI bridge currently targets Windows x64 with MSVC")
+    endif()
+    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+        message(FATAL_ERROR "The DSP56300 FFI bridge requires a 64-bit Windows build")
+    endif()
+
+    set(DSP56300_SOURCE_DIR "" CACHE PATH "Path to xemu-project/dsp56300 at the reviewed commit")
+    if(NOT EXISTS "${DSP56300_SOURCE_DIR}/crates/emu-ffi/Cargo.toml")
+        message(FATAL_ERROR "Set DSP56300_SOURCE_DIR to the reviewed dsp56300 checkout")
+    endif()
+    find_package(Git REQUIRED)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${DSP56300_SOURCE_DIR}" rev-parse HEAD
+        OUTPUT_VARIABLE DSP56300_ACTUAL_REVISION
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        RESULT_VARIABLE DSP56300_REVISION_RESULT)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${DSP56300_SOURCE_DIR}" status --porcelain
+        OUTPUT_VARIABLE DSP56300_WORKTREE_CHANGES
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        RESULT_VARIABLE DSP56300_STATUS_RESULT)
+    if(NOT DSP56300_REVISION_RESULT EQUAL 0 OR
+       NOT DSP56300_ACTUAL_REVISION STREQUAL "82fb25a6917a36ac66212ae31f02aab62211f979" OR
+       NOT DSP56300_STATUS_RESULT EQUAL 0 OR
+       NOT DSP56300_WORKTREE_CHANGES STREQUAL "")
+        message(FATAL_ERROR
+            "DSP56300_SOURCE_DIR must be a clean checkout at reviewed commit 82fb25a6917a36ac66212ae31f02aab62211f979")
+    endif()
+    find_program(CARGO_EXECUTABLE cargo REQUIRED)
+
+    set(DSP56300_TARGET_TRIPLE "x86_64-pc-windows-msvc")
+    set(DSP56300_CARGO_TARGET_DIR "${CMAKE_BINARY_DIR}/dsp56300-cargo")
+    set(DSP56300_STATIC_LIBRARY
+        "${DSP56300_CARGO_TARGET_DIR}/${DSP56300_TARGET_TRIPLE}/release/dsp56300_emu_ffi.lib")
+    file(GLOB_RECURSE DSP56300_BUILD_INPUTS CONFIGURE_DEPENDS
+        "${DSP56300_SOURCE_DIR}/Cargo.toml"
+        "${DSP56300_SOURCE_DIR}/Cargo.lock"
+        "${DSP56300_SOURCE_DIR}/crates/*.toml"
+        "${DSP56300_SOURCE_DIR}/crates/*.rs"
+        "${DSP56300_SOURCE_DIR}/crates/*.c"
+        "${DSP56300_SOURCE_DIR}/crates/*.h")
+
+    add_custom_command(
+        OUTPUT "${DSP56300_STATIC_LIBRARY}"
+        COMMAND "${CMAKE_COMMAND}" -E env
+            "CARGO_TARGET_DIR=${DSP56300_CARGO_TARGET_DIR}"
+            "${CARGO_EXECUTABLE}" build --locked --release --no-default-features
+                --target "${DSP56300_TARGET_TRIPLE}"
+                --manifest-path "${DSP56300_SOURCE_DIR}/Cargo.toml"
+                -p dsp56300-emu-ffi
+        DEPENDS ${DSP56300_BUILD_INPUTS}
+        WORKING_DIRECTORY "${DSP56300_SOURCE_DIR}"
+        COMMENT "Building the pinned DSP56300 Windows x64 C FFI"
+        VERBATIM)
+    add_custom_target(dsp56300_ffi_build DEPENDS "${DSP56300_STATIC_LIBRARY}")
+    add_library(dsp56300_ffi STATIC IMPORTED GLOBAL)
+    set_target_properties(dsp56300_ffi PROPERTIES
+        IMPORTED_LOCATION "${DSP56300_STATIC_LIBRARY}")
+    add_dependencies(xbox_apu dsp56300_ffi_build)
+    target_sources(xbox_apu PRIVATE apu_dsp56300_bridge.c)
+    target_include_directories(xbox_apu PRIVATE
+        "${DSP56300_SOURCE_DIR}/crates/emu-ffi/include")
+    target_compile_definitions(xbox_apu PRIVATE MCPX_APU_USE_DSP56300=1)
+    target_link_libraries(xbox_apu PRIVATE dsp56300_ffi)
+endif()
+
 target_include_directories(xbox_apu PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
 
