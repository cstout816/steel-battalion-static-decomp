diff --git a/src/apu/apu_dsp56300_bridge.c b/src/apu/apu_dsp56300_bridge.c
new file mode 100644
index 0000000..881e221
--- /dev/null
+++ b/src/apu/apu_dsp56300_bridge.c
@@ -0,0 +1,96 @@
+/*
+ * XboxRecomp-owned adapter between the MCPX APU state and the MIT DSP56300 C FFI.
+ * The FFI receives stable backing arrays owned by DSPState. This file only
+ * creates, resets, and destroys the core; it does not yet route GP/EP MMIO,
+ * bootstrap firmware, schedule DSP cycles, perform DMA, or produce audio.
+ */
+#include "apu_dsp56300_bridge.h"
+
+#include "apu_state.h"
+#include "dsp56300.h"
+
+#include <string.h>
+
+#define GP_X_RAM_WORDS 0x1000u
+#define GP_MIXBUF_START 0x1400u
+#define GP_MIXBUF_WORDS 0x0400u
+#define GP_Y_RAM_WORDS 0x0800u
+#define EP_X_RAM_WORDS 0x0C00u
+#define EP_Y_RAM_WORDS 0x0100u
+#define DSP_P_RAM_WORDS 0x1000u
+
+_Static_assert(DSP_XRAM_SIZE >= GP_X_RAM_WORDS,
+               "GP DSP X backing storage is too small");
+_Static_assert(DSP_YRAM_SIZE >= GP_Y_RAM_WORDS,
+               "GP DSP Y backing storage is too small");
+_Static_assert(DSP_PRAM_SIZE >= DSP_P_RAM_WORDS,
+               "DSP P backing storage is too small");
+_Static_assert(DSP_MIXBUFFER_SIZE == GP_MIXBUF_WORDS,
+               "GP mixbin window and backing storage differ");
+
+static void set_buffer_region(Dsp56300MemoryRegion *region,
+                              uint32_t start,
+                              uint32_t end,
+                              uint32_t *base)
+{
+    memset(region, 0, sizeof(*region));
+    region->start = start;
+    region->end = end;
+    region->kind = DSP56300_REGION_BUFFER;
+    region->data.buffer.base = base;
+    region->data.buffer.offset = 0;
+}
+
+bool mcpx_apu_dsp_engine_init(DSPState *dsp)
+{
+    Dsp56300MemoryRegion x_regions[2];
+    Dsp56300MemoryRegion y_region;
+    Dsp56300MemoryRegion p_region;
+    Dsp56300CreateInfo info;
+
+    if (!dsp || dsp->jit) {
+        return dsp && dsp->jit;
+    }
+
+    memset(&info, 0, sizeof(info));
+    if (dsp->is_gp) {
+        set_buffer_region(&x_regions[0], 0, GP_X_RAM_WORDS, dsp->core.xram);
+        set_buffer_region(&x_regions[1], GP_MIXBUF_START,
+                          GP_MIXBUF_START + GP_MIXBUF_WORDS,
+                          dsp->core.mixbuffer);
+        set_buffer_region(&y_region, 0, GP_Y_RAM_WORDS, dsp->core.yram);
+        info.memory_map.x_regions = x_regions;
+        info.memory_map.x_count = 2;
+    } else {
+        set_buffer_region(&x_regions[0], 0, EP_X_RAM_WORDS, dsp->core.xram);
+        set_buffer_region(&y_region, 0, EP_Y_RAM_WORDS, dsp->core.yram);
+        info.memory_map.x_regions = x_regions;
+        info.memory_map.x_count = 1;
+    }
+
+    set_buffer_region(&p_region, 0, DSP_P_RAM_WORDS, dsp->core.pram);
+    info.memory_map.y_regions = &y_region;
+    info.memory_map.y_count = 1;
+    info.memory_map.p_regions = &p_region;
+    info.memory_map.p_count = 1;
+
+    /* The FFI copies region descriptors but retains all buffer pointers. The
+     * DSPState and its arrays must therefore outlive the returned JIT handle. */
+    dsp->jit = dsp56300_create(&info);
+    return dsp->jit != NULL;
+}
+
+void mcpx_apu_dsp_engine_destroy(DSPState *dsp)
+{
+    if (dsp && dsp->jit) {
+        dsp56300_destroy(dsp->jit);
+        dsp->jit = NULL;
+    }
+}
+
+void mcpx_apu_dsp_engine_reset(DSPState *dsp)
+{
+    if (dsp && dsp->jit) {
+        dsp56300_reset(dsp->jit);
+    }
+}
