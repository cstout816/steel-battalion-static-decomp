diff --git a/tests/dsp56300_memory_map_test.c b/tests/dsp56300_memory_map_test.c
new file mode 100644
index 0000000..19f93bf
--- /dev/null
+++ b/tests/dsp56300_memory_map_test.c
@@ -0,0 +1,141 @@
+/*
+ * Focused C ABI check for the XboxRecomp-owned DSP56300 memory map.
+ * This does not execute firmware or claim APU audio compatibility.
+ */
+#include "apu_dsp56300_bridge.h"
+
+#include "dsp56300.h"
+
+#include <stdint.h>
+#include <stdio.h>
+
+static int check_word(const char *name,
+                      const DSPState *dsp,
+                      Dsp56300MemSpace space,
+                      uint32_t address,
+                      uint32_t *backing_word,
+                      uint32_t value)
+{
+    dsp56300_write_memory((Dsp56300Jit *)dsp->jit, space, address, value);
+    if (*backing_word != value ||
+        dsp56300_read_memory((const Dsp56300Jit *)dsp->jit, space, address) != value) {
+        fprintf(stderr, "DSP memory-map check failed: %s\n", name);
+        return 0;
+    }
+    return 1;
+}
+
+static int check_mmio_word(const char *name, DSPState *dsp,
+                           uint32_t byte_offset, uint32_t *backing_word,
+                           uint32_t value)
+{
+    uint32_t actual = 0;
+    if (!mcpx_apu_dsp_memory_write(dsp, byte_offset, value) ||
+        *backing_word != (value & 0x00FFFFFFu) ||
+        !mcpx_apu_dsp_memory_read(dsp, byte_offset, &actual) ||
+        actual != (value & 0x00FFFFFFu)) {
+        fprintf(stderr, "DSP guest MMIO check failed: %s\n", name);
+        return 0;
+    }
+    return 1;
+}
+
+static int check_gp_map(void)
+{
+    DSPState gp = {0};
+    uint32_t guest_ram[0x4000] = {0};
+    int ok = 1;
+
+    gp.is_gp = true;
+    gp.guest_mmio_base = (uint8_t *)guest_ram;
+    if (!mcpx_apu_dsp_engine_init(&gp)) {
+        fprintf(stderr, "GP DSP56300 engine creation failed\n");
+        return 0;
+    }
+
+    ok &= check_word("GP X first word", &gp, DSP56300_MEM_SPACE_X,
+                     0x0000, &guest_ram[0x0000], 0x12345);
+    ok &= check_word("GP X last word", &gp, DSP56300_MEM_SPACE_X,
+                     0x0FFF, &guest_ram[0x0FFF], 0x23456);
+    ok &= check_word("GP mixbuffer first word", &gp, DSP56300_MEM_SPACE_X,
+                     0x1400, &guest_ram[0x1400], 0x34567);
+    ok &= check_word("GP mixbuffer last word", &gp, DSP56300_MEM_SPACE_X,
+                     0x17FF, &guest_ram[0x17FF], 0x45678);
+    ok &= check_word("GP Y last word", &gp, DSP56300_MEM_SPACE_Y,
+                     0x07FF, &guest_ram[0x6000 / 4 + 0x07FF], 0x56789);
+    ok &= check_word("GP P last word", &gp, DSP56300_MEM_SPACE_P,
+                     0x0FFF, &guest_ram[0xA000 / 4 + 0x0FFF], 0x6789A);
+    ok &= check_mmio_word("GP X window end", &gp, 0x0FFCu,
+                          &guest_ram[0x03FF], 0xFF123456u);
+    ok &= check_mmio_word("GP mixbuffer window end", &gp, 0x5FFCu,
+                          &guest_ram[0x5000 / 4 + 0x03FF], 0xFF234567u);
+    ok &= check_mmio_word("GP Y window end", &gp, 0x7FFCu,
+                          &guest_ram[0x6000 / 4 + 0x07FF], 0xFF345678u);
+    ok &= check_mmio_word("GP P window end", &gp, 0xDFFCu,
+                          &guest_ram[0xA000 / 4 + 0x0FFF], 0xFF456789u);
+    {
+        uint32_t ignored;
+        if (mcpx_apu_dsp_memory_read(&gp, 0x4000u, &ignored) ||
+            mcpx_apu_dsp_memory_write(&gp, 0x4000u, 1u)) {
+            fprintf(stderr, "GP unmapped hole incorrectly aliases DSP RAM\n");
+            ok = 0;
+        }
+    }
+
+    if (!mcpx_apu_dsp_engine_init(&gp) || !gp.jit) {
+        fprintf(stderr, "GP engine initialization is not idempotent\n");
+        ok = 0;
+    }
+    mcpx_apu_dsp_engine_reset(&gp);
+    mcpx_apu_dsp_engine_destroy(&gp);
+    mcpx_apu_dsp_engine_destroy(&gp);
+    return ok;
+}
+
+static int check_ep_map(void)
+{
+    DSPState ep = {0};
+    uint32_t guest_ram[0x4000] = {0};
+    int ok = 1;
+
+    ep.is_gp = false;
+    ep.guest_mmio_base = (uint8_t *)guest_ram;
+    if (!mcpx_apu_dsp_engine_init(&ep)) {
+        fprintf(stderr, "EP DSP56300 engine creation failed\n");
+        return 0;
+    }
+
+    ok &= check_word("EP X last word", &ep, DSP56300_MEM_SPACE_X,
+                     0x0BFF, &guest_ram[0x0BFF], 0x789AB);
+    ok &= check_word("EP Y last word", &ep, DSP56300_MEM_SPACE_Y,
+                     0x00FF, &guest_ram[0x6000 / 4 + 0x00FF], 0x89ABC);
+    ok &= check_word("EP P last word", &ep, DSP56300_MEM_SPACE_P,
+                     0x0FFF, &guest_ram[0xA000 / 4 + 0x0FFF], 0x9ABCD);
+    ok &= check_mmio_word("EP X window end", &ep, 0x2FFCu,
+                          &guest_ram[0x0BFF], 0xFFA12345u);
+    ok &= check_mmio_word("EP Y window end", &ep, 0x63FCu,
+                          &guest_ram[0x6000 / 4 + 0x00FF], 0xFFB23456u);
+    ok &= check_mmio_word("EP P window end", &ep, 0xDFFCu,
+                          &guest_ram[0xA000 / 4 + 0x0FFF], 0xFFC34567u);
+    {
+        uint32_t ignored;
+        if (mcpx_apu_dsp_memory_read(&ep, 0x3000u, &ignored) ||
+            mcpx_apu_dsp_memory_write(&ep, 0x3000u, 1u)) {
+            fprintf(stderr, "EP unmapped hole incorrectly aliases DSP RAM\n");
+            ok = 0;
+        }
+    }
+
+    mcpx_apu_dsp_engine_reset(&ep);
+    mcpx_apu_dsp_engine_destroy(&ep);
+    return ok;
+}
+
+int main(void)
+{
+    if (!check_gp_map() || !check_ep_map()) {
+        return 1;
+    }
+    puts("DSP56300 FFI memory map and lifecycle checks passed");
+    return 0;
+}
