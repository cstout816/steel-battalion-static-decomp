+static bool apu_gp_ep_trace_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("RECOMP_APU_GP_EP_TRACE");
+        enabled = value && value[0] == '1';
+    }
+    return enabled != 0;
+}
+
+static void apu_gp_ep_trace(bool is_gp, bool is_write, uint32_t offset,
+                            uint32_t value, unsigned int size)
+{
+    static volatile LONG trace_count;
+    LONG ordinal;
+    if (!apu_gp_ep_trace_enabled()) {
+        return;
+    }
+    ordinal = InterlockedIncrement(&trace_count);
+    if (ordinal <= 512) {
+        fprintf(stderr, "[APU-%s] %s offset=0x%04X size=%u value=0x%08X\n",
+                is_gp ? "GP" : "EP", is_write ? "write" : "read",
+                offset, size, value);
+    } else if (ordinal == 513) {
+        fprintf(stderr, "[APU] GP/EP MMIO trace capped at 512 accesses\n");
+    }
+}
+
+static void mcpx_apu_dsp_sync_reset(MCPXAPUState *d, bool is_gp)
+{
+    DSPState *dsp = is_gp ? d->gp.dsp : d->ep.dsp;
+    uint32_t *regs = is_gp ? d->gp.regs : d->ep.regs;
+    uint8_t *window = d->mcpx_ptr
+        ? d->mcpx_ptr + (is_gp ? 0x30000u : 0x50000u)
+        : NULL;
+    uint32_t old_value;
+    uint32_t value;
+    const uint32_t reset_reg = is_gp ? NV_PAPU_GPRST : NV_PAPU_EPRST;
+
+    if (!window || !dsp) {
+        return;
+    }
+    value = *(volatile uint32_t *)(window + reset_reg);
+    old_value = regs[reset_reg];
+    if (value == old_value) {
+        return;
+    }
+    regs[reset_reg] = value;
+    if (!(value & NV_PAPU_GPRST_GPRST) ||
+        !(value & NV_PAPU_GPRST_GPDSPRST)) {
+#ifdef MCPX_APU_USE_DSP56300
+        mcpx_apu_dsp_engine_reset(dsp);
+#endif
+    } else if ((!(old_value & NV_PAPU_GPRST_GPRST) ||
+                !(old_value & NV_PAPU_GPRST_GPDSPRST)) &&
+               (value & NV_PAPU_GPRST_GPRST) &&
+               (value & NV_PAPU_GPRST_GPDSPRST)) {
+        fprintf(stderr, "[APU] %s DSP reset released; firmware bootstrap is not implemented\n",
+                is_gp ? "GP" : "EP");
+    }
+    if (!is_gp) {
+        d->ep_frame_div = 0;
+    }
+}
