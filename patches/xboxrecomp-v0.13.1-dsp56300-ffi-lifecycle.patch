index 0000000..0c46c33
--- /dev/null
+++ b/src/apu/apu_dsp56300_bridge.c
@@ -0,0 +1,264 @@
+/*
+ * XboxRecomp-owned adapter between the MCPX APU state and the MIT DSP56300 C FFI.
+ * The FFI receives stable backing arrays owned by DSPState. This file maps
+ * guest GP/EP RAM windows and manages the optional core lifecycle. Firmware
+ * bootstrap, DSP cycle scheduling, DMA, and audio generation are not wired.
+ */
+#include "apu_dsp56300_bridge.h"
+
+#include "apu_state.h"
+#ifdef MCPX_APU_USE_DSP56300
+#include "dsp56300.h"
+#endif
+
+#include <string.h>
+
+#define GP_X_RAM_WORDS 0x1000u
+#define GP_MIXBUF_START 0x1400u
+#define GP_MIXBUF_WORDS 0x0400u
+#define GP_Y_RAM_WORDS 0x0800u
+#define EP_X_RAM_WORDS 0x0C00u
+#define EP_Y_RAM_WORDS 0x0100u
+#define DSP_P_RAM_WORDS 0x1000u
+#define DSP_WORD_MASK 0x00FFFFFFu
+
+typedef enum {
+    DSP_MMIO_SPACE_X,
+    DSP_MMIO_SPACE_Y,
+    DSP_MMIO_SPACE_P
+} DspMmioSpace;
+
+_Static_assert(DSP_XRAM_SIZE >= GP_X_RAM_WORDS,
+               "GP DSP X backing storage is too small");
+_Static_assert(DSP_YRAM_SIZE >= GP_Y_RAM_WORDS,
+               "GP DSP Y backing storage is too small");
+_Static_assert(DSP_PRAM_SIZE >= DSP_P_RAM_WORDS,
+               "DSP P backing storage is too small");
+_Static_assert(DSP_MIXBUFFER_SIZE == GP_MIXBUF_WORDS,
+               "GP mixbin window and backing storage differ");
+
+#ifdef MCPX_APU_USE_DSP56300
+static void set_buffer_region(Dsp56300MemoryRegion *region,
+                              uint32_t start,
+                              uint32_t end,
+                              uint32_t *base)
+{
+    memset(region, 0, sizeof(*region));
+    region->start = start;
+    region->end = end;
+    region->kind = DSP56300_REGION_BUFFER;
+    region->data.buffer.base = base;
+    region->data.buffer.offset = 0;
+}
+#endif
+
+bool mcpx_apu_dsp_engine_init(DSPState *dsp)
+{
+#ifndef MCPX_APU_USE_DSP56300
+    (void)dsp;
+    return false;
+#else
+    Dsp56300MemoryRegion x_regions[2];
+    Dsp56300MemoryRegion y_region;
+    Dsp56300MemoryRegion p_region;
+    Dsp56300CreateInfo info;
+
+    if (!dsp || dsp->jit) {
+        return dsp && dsp->jit;
+    }
+
+    memset(&info, 0, sizeof(info));
+    if (dsp->is_gp) {
+        uint8_t *base = dsp->guest_mmio_base;
+        set_buffer_region(&x_regions[0], 0, GP_X_RAM_WORDS,
+                          base ? (uint32_t *)(base + 0x0000u) : dsp->core.xram);
+        set_buffer_region(&x_regions[1], GP_MIXBUF_START,
+                          GP_MIXBUF_START + GP_MIXBUF_WORDS,
+                          base ? (uint32_t *)(base + 0x5000u) : dsp->core.mixbuffer);
+        set_buffer_region(&y_region, 0, GP_Y_RAM_WORDS,
+                          base ? (uint32_t *)(base + 0x6000u) : dsp->core.yram);
+        info.memory_map.x_regions = x_regions;
+        info.memory_map.x_count = 2;
+    } else {
+        uint8_t *base = dsp->guest_mmio_base;
+        set_buffer_region(&x_regions[0], 0, EP_X_RAM_WORDS,
+                          base ? (uint32_t *)(base + 0x0000u) : dsp->core.xram);
+        set_buffer_region(&y_region, 0, EP_Y_RAM_WORDS,
+                          base ? (uint32_t *)(base + 0x6000u) : dsp->core.yram);
+        info.memory_map.x_regions = x_regions;
+        info.memory_map.x_count = 1;
+    }
+
+    set_buffer_region(&p_region, 0, DSP_P_RAM_WORDS,
+                      dsp->guest_mmio_base
+                          ? (uint32_t *)(dsp->guest_mmio_base + 0xA000u)
+                          : dsp->core.pram);
+    info.memory_map.y_regions = &y_region;
+    info.memory_map.y_count = 1;
+    info.memory_map.p_regions = &p_region;
+    info.memory_map.p_count = 1;
+
+    /* The FFI copies region descriptors but retains all buffer pointers. The
+     * guest MCPX aperture (or fallback DSPState arrays) must outlive the JIT. */
+    dsp->jit = dsp56300_create(&info);
+    return dsp->jit != NULL;
+#endif
+}
+
+void mcpx_apu_dsp_engine_destroy(DSPState *dsp)
+{
+#ifdef MCPX_APU_USE_DSP56300
+    if (dsp && dsp->jit) {
+        dsp56300_destroy(dsp->jit);
+        dsp->jit = NULL;
+    }
+#else
+    (void)dsp;
+#endif
+}
+
+void mcpx_apu_dsp_engine_reset(DSPState *dsp)
+{
+#ifdef MCPX_APU_USE_DSP56300
+    if (dsp && dsp->jit) {
+        dsp56300_reset(dsp->jit);
+    }
+#else
+    (void)dsp;
+#endif
+}
+
+/* Translate guest-visible byte offsets to the DSP's 24-bit word spaces.
+ * False means the access is a peripheral register or an unmapped hole. */
+static bool mmio_word(DSPState *dsp, uint32_t byte_offset,
+                      DspMmioSpace *space, uint32_t *word)
+{
+    if (!dsp || (byte_offset & 3u) != 0) {
+        return false;
+    }
+    if (dsp->is_gp) {
+        if (byte_offset < GP_X_RAM_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_X;
+            *word = byte_offset / 4u;
+        } else if (byte_offset >= 0x5000u &&
+                   byte_offset < 0x5000u + GP_MIXBUF_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_X;
+            *word = GP_MIXBUF_START + (byte_offset - 0x5000u) / 4u;
+        } else if (byte_offset >= 0x6000u &&
+                   byte_offset < 0x6000u + GP_Y_RAM_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_Y;
+            *word = (byte_offset - 0x6000u) / 4u;
+        } else if (byte_offset >= 0xA000u &&
+                   byte_offset < 0xA000u + DSP_P_RAM_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_P;
+            *word = (byte_offset - 0xA000u) / 4u;
+        } else {
+            return false;
+        }
+    } else {
+        if (byte_offset < EP_X_RAM_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_X;
+            *word = byte_offset / 4u;
+        } else if (byte_offset >= 0x6000u &&
+                   byte_offset < 0x6000u + EP_Y_RAM_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_Y;
+            *word = (byte_offset - 0x6000u) / 4u;
+        } else if (byte_offset >= 0xA000u &&
+                   byte_offset < 0xA000u + DSP_P_RAM_WORDS * 4u) {
+            *space = DSP_MMIO_SPACE_P;
+            *word = (byte_offset - 0xA000u) / 4u;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+static uint32_t *mmio_backing_word(DSPState *dsp,
+                                   DspMmioSpace space,
+                                   uint32_t word)
+{
+    if (dsp->guest_mmio_base) {
+        uint32_t byte_offset;
+        if (space == DSP_MMIO_SPACE_X) {
+            byte_offset = dsp->is_gp && word >= GP_MIXBUF_START
+                    && word < GP_MIXBUF_START + GP_MIXBUF_WORDS
+                ? 0x5000u + (word - GP_MIXBUF_START) * 4u
+                : word * 4u;
+        } else if (space == DSP_MMIO_SPACE_Y) {
+            byte_offset = 0x6000u + word * 4u;
+        } else {
+            byte_offset = 0xA000u + word * 4u;
+        }
+        return (uint32_t *)(dsp->guest_mmio_base + byte_offset);
+    }
+    if (space == DSP_MMIO_SPACE_X) {
+        if (dsp->is_gp && word >= GP_MIXBUF_START &&
+            word < GP_MIXBUF_START + GP_MIXBUF_WORDS) {
+            return &dsp->core.mixbuffer[word - GP_MIXBUF_START];
+        }
+        return &dsp->core.xram[word];
+    }
+    if (space == DSP_MMIO_SPACE_Y) {
+        return &dsp->core.yram[word];
+    }
+    return &dsp->core.pram[word];
+}
+
+bool mcpx_apu_dsp_memory_read(DSPState *dsp, uint32_t byte_offset,
+                              uint32_t *value)
+{
+    DspMmioSpace space;
+    uint32_t word;
+    if (!value || !mmio_word(dsp, byte_offset, &space, &word)) {
+        return false;
+    }
+    *value = *mmio_backing_word(dsp, space, word) & DSP_WORD_MASK;
+    return true;
+}
+
+void mcpx_apu_dsp_sync_program_cache(DSPState *dsp)
+{
+#ifdef MCPX_APU_USE_DSP56300
+    uint32_t *program;
+    uint64_t hash = UINT64_C(1469598103934665603);
+
+    if (!dsp || !dsp->jit || !dsp->guest_mmio_base) {
+        return;
+    }
+    program = (uint32_t *)(dsp->guest_mmio_base + 0xA000u);
+    for (uint32_t i = 0; i < DSP_P_RAM_WORDS; ++i) {
+        hash ^= program[i] & DSP_WORD_MASK;
+        hash *= UINT64_C(1099511628211);
+    }
+    if (!dsp->guest_program_hash_valid || hash != dsp->guest_program_hash) {
+        dsp56300_invalidate_cache((Dsp56300Jit *)dsp->jit);
+        dsp->guest_program_hash = hash;
+        dsp->guest_program_hash_valid = true;
+    }
+#else
+    (void)dsp;
+#endif
+}
+
+bool mcpx_apu_dsp_memory_write(DSPState *dsp, uint32_t byte_offset,
+                               uint32_t value)
+{
+    DspMmioSpace space;
+    uint32_t word;
+    if (!mmio_word(dsp, byte_offset, &space, &word)) {
+        return false;
+    }
+    value &= DSP_WORD_MASK;
+#ifdef MCPX_APU_USE_DSP56300
+    if (space == DSP_MMIO_SPACE_P && dsp->jit) {
+        dsp56300_write_memory((Dsp56300Jit *)dsp->jit,
+                              DSP56300_MEM_SPACE_P, word, value);
+    } else {
+        *mmio_backing_word(dsp, space, word) = value;
+    }
+#else
+    *mmio_backing_word(dsp, space, word) = value;
+#endif
+    return true;
+}
