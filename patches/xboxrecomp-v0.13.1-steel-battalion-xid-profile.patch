+/* The Steel Battalion XID profile is opt-in so other games continue to see
+ * the ordinary Controller-S device. */
+static int usb_steel_battalion_profile(void)
+{
+    static int profile = -1;
+    if (profile < 0) {
+        const char *value = getenv("RECOMP_USB_PROFILE");
+        profile = value && strcmp(value, "steel-battalion") == 0;
+    }
+    return profile;
+}
