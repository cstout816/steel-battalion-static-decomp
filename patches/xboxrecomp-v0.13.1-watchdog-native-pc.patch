     fprintf(stderr, "[WATCHDOG] no exit after %us; guest esp=0x%08X\n"
             "  regs: eax=%08X ecx=%08X edx=%08X ebx=%08X esi=%08X edi=%08X\n",
             s_watchdog_secs, esp,
