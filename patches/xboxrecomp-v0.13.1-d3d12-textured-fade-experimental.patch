+static int ensure_texture(D3D12Raster *r, uint32_t width, uint32_t height)
+{
+    D3D12_RESOURCE_DESC desc;
+    D3D12_HEAP_PROPERTIES heap;
+    D3D12_DESCRIPTOR_HEAP_DESC heap_desc;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint;
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv;
+    D3D12_CPU_DESCRIPTOR_HANDLE handle;
+    UINT rows = 0;
+    UINT64 row_bytes = 0, total_bytes = 0;
+    HRESULT hr;
+    if (!width || !height || width > 4096 || height > 4096)
+        return 0;
+    if (r->texture && r->texture_width == width && r->texture_height == height)
+        return 1;
+    if (r->texture_upload_map && r->texture_upload)
+        ID3D12Resource_Unmap(r->texture_upload, 0, NULL);
+    r->texture_upload_map = NULL;
+    RELEASE(r->texture);
+    RELEASE(r->texture_upload);
+    RELEASE(r->srv_heap);
+
+    memset(&desc, 0, sizeof(desc));
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    memset(&heap, 0, sizeof(heap));
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    heap.CreationNodeMask = 1;
+    heap.VisibleNodeMask = 1;
+    hr = ID3D12Device_CreateCommittedResource(
+        r->device, &heap, D3D12_HEAP_FLAG_NONE, &desc,
+        D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource,
+        (void **)&r->texture);
+    if (FAILED(hr))
+        goto failed;
+    ID3D12Device_GetCopyableFootprints(r->device, &desc, 0, 1, 0,
+                                       &footprint, &rows, &row_bytes,
+                                       &total_bytes);
+    r->texture_row_pitch = footprint.Footprint.RowPitch;
+    hr = make_buffer(r->device, D3D12_HEAP_TYPE_UPLOAD, total_bytes,
+                     D3D12_RESOURCE_STATE_GENERIC_READ, &r->texture_upload);
+    if (FAILED(hr))
+        goto failed;
+    {
+        D3D12_RANGE read_range = {0, 0};
+        void *mapped = NULL;
+        hr = ID3D12Resource_Map(r->texture_upload, 0, &read_range, &mapped);
+        if (FAILED(hr))
+            goto failed;
+        r->texture_upload_map = (uint8_t *)mapped;
+    }
+    memset(&heap_desc, 0, sizeof(heap_desc));
+    heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    heap_desc.NumDescriptors = 1;
+    heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    hr = ID3D12Device_CreateDescriptorHeap(
+        r->device, &heap_desc, &IID_ID3D12DescriptorHeap,
+        (void **)&r->srv_heap);
+    if (FAILED(hr))
+        goto failed;
+    (void)ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(
+        r->srv_heap, &handle);
+    memset(&srv, 0, sizeof(srv));
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    srv.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv.Texture2D.MipLevels = 1;
+    ID3D12Device_CreateShaderResourceView(r->device, r->texture, &srv, handle);
+    r->texture_width = width;
+    r->texture_height = height;
+    r->texture_state = D3D12_RESOURCE_STATE_COMMON;
+    return 1;
+
+failed:
+    fprintf(stderr, "[D3D12-R] texture allocation failed (0x%08lX)\n",
+            (unsigned long)hr);
+    if (r->texture_upload_map && r->texture_upload)
+        ID3D12Resource_Unmap(r->texture_upload, 0, NULL);
+    r->texture_upload_map = NULL;
+    RELEASE(r->texture);
+    RELEASE(r->texture_upload);
+    RELEASE(r->srv_heap);
+    r->texture_width = r->texture_height = r->texture_row_pitch = 0;
+    return 0;
 }
 
