+int nv2a_d3d12_raster_textured_triangles(
+    uint8_t *surface, uint32_t pitch, uint32_t width, uint32_t height,
+    uint32_t clip_x, uint32_t clip_y, uint32_t clip_w, uint32_t clip_h,
+    const float vertices[][8], uint32_t vertex_count,
+    const uint8_t *rgba, uint32_t texture_width, uint32_t texture_height)
+{
+    D3D12Raster *r = &g_d3d12;
+    D3D12_TEXTURE_COPY_LOCATION src, dst;
+    D3D12_RESOURCE_BARRIER barrier[2];
+    D3D12_VIEWPORT viewport;
+    D3D12_RECT scissor;
+    D3D12_VERTEX_BUFFER_VIEW vbv;
+    D3D12_RANGE read_range;
+    D3D12_GPU_DESCRIPTOR_HANDLE srv_handle;
+    uint32_t y, i;
+    uint8_t *mapped = NULL;
+    HRESULT hr;
+    if (!surface || !pitch || !width || !height || !vertices || !rgba
+        || vertex_count != 6 || pitch < width * 4
+        || !initialize(r) || !ensure_targets(r, width, height)
+        || !ensure_texture(r, texture_width, texture_height))
+        return 0;
+
+    for (y = 0; y < height; y++)
+        memcpy(r->upload_map + (size_t)y * r->row_pitch,
+               surface + (size_t)y * pitch, (size_t)width * 4);
+    for (y = 0; y < texture_height; y++)
+        memcpy(r->texture_upload_map + (size_t)y * r->texture_row_pitch,
+               rgba + (size_t)y * texture_width * 4,
+               (size_t)texture_width * 4);
+    for (i = 0; i < vertex_count; i++) {
+        D3D12Vertex *v = &r->mapped_vertices[i];
+        v->x = vertices[i][0] * (2.0f / (float)width) - 1.0f;
+        v->y = 1.0f - vertices[i][1] * (2.0f / (float)height);
+        v->u = vertices[i][2];
+        v->v = vertices[i][3];
+        v->r = vertices[i][4];
+        v->g = vertices[i][5];
+        v->b = vertices[i][6];
+        v->a = vertices[i][7];
+    }
+
+    hr = ID3D12CommandAllocator_Reset(r->allocator);
+    if (FAILED(hr))
+        return 0;
+    hr = ID3D12GraphicsCommandList_Reset(r->commands, r->allocator,
+                                         r->textured_pipeline);
+    if (FAILED(hr))
+        return 0;
+
+    if (r->target_state != D3D12_RESOURCE_STATE_COPY_DEST) {
+        memset(&barrier[0], 0, sizeof(barrier[0]));
+        barrier[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        barrier[0].Transition.pResource = r->target;
+        barrier[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        barrier[0].Transition.StateBefore = r->target_state;
+        barrier[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        ID3D12GraphicsCommandList_ResourceBarrier(r->commands, 1, &barrier[0]);
+    }
+    memset(&src, 0, sizeof(src));
+    src.pResource = r->upload;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Offset = 0;
+    src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    src.PlacedFootprint.Footprint.Width = width;
+    src.PlacedFootprint.Footprint.Height = height;
+    src.PlacedFootprint.Footprint.Depth = 1;
+    src.PlacedFootprint.Footprint.RowPitch = r->row_pitch;
+    memset(&dst, 0, sizeof(dst));
+    dst.pResource = r->target;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.SubresourceIndex = 0;
+    ID3D12GraphicsCommandList_CopyTextureRegion(r->commands, &dst, 0, 0, 0,
+                                               &src, NULL);
+
+    memset(barrier, 0, sizeof(barrier));
+    barrier[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier[0].Transition.pResource = r->target;
+    barrier[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barrier[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barrier[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier[1].Transition.pResource = r->texture;
+    barrier[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier[1].Transition.StateBefore = r->texture_state;
+    barrier[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    ID3D12GraphicsCommandList_ResourceBarrier(r->commands, 2, barrier);
+    memset(&src, 0, sizeof(src));
+    src.pResource = r->texture_upload;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Offset = 0;
+    src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    src.PlacedFootprint.Footprint.Width = texture_width;
+    src.PlacedFootprint.Footprint.Height = texture_height;
+    src.PlacedFootprint.Footprint.Depth = 1;
+    src.PlacedFootprint.Footprint.RowPitch = r->texture_row_pitch;
+    memset(&dst, 0, sizeof(dst));
+    dst.pResource = r->texture;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.SubresourceIndex = 0;
+    ID3D12GraphicsCommandList_CopyTextureRegion(r->commands, &dst, 0, 0, 0,
+                                               &src, NULL);
+
+    memset(barrier, 0, sizeof(barrier));
+    barrier[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier[0].Transition.pResource = r->target;
+    barrier[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barrier[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barrier[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier[1].Transition.pResource = r->texture;
+    barrier[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barrier[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    ID3D12GraphicsCommandList_ResourceBarrier(r->commands, 1, &barrier[1]);
+
+    ID3D12GraphicsCommandList_OMSetRenderTargets(r->commands, 1, &r->rtv,
+                                                 FALSE, NULL);
+    viewport.TopLeftX = 0.0f;
+    viewport.TopLeftY = 0.0f;
+    viewport.Width = (float)width;
+    viewport.Height = (float)height;
+    viewport.MinDepth = 0.0f;
+    viewport.MaxDepth = 1.0f;
+    ID3D12GraphicsCommandList_RSSetViewports(r->commands, 1, &viewport);
+    scissor.left = (LONG)clip_x;
+    scissor.top = (LONG)clip_y;
+    scissor.right = (LONG)(clip_x + clip_w);
+    scissor.bottom = (LONG)(clip_y + clip_h);
+    ID3D12GraphicsCommandList_RSSetScissorRects(r->commands, 1, &scissor);
+    ID3D12GraphicsCommandList_SetGraphicsRootSignature(r->commands,
+                                                       r->root_signature);
+    ID3D12GraphicsCommandList_SetPipelineState(r->commands, r->textured_pipeline);
+    ID3D12GraphicsCommandList_IASetPrimitiveTopology(
+        r->commands, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    vbv.BufferLocation = ID3D12Resource_GetGPUVirtualAddress(r->vertices);
+    vbv.SizeInBytes = sizeof(D3D12Vertex) * vertex_count;
+    vbv.StrideInBytes = sizeof(D3D12Vertex);
+    ID3D12GraphicsCommandList_IASetVertexBuffers(r->commands, 0, 1, &vbv);
+    ID3D12GraphicsCommandList_SetDescriptorHeaps(r->commands, 1, &r->srv_heap);
+    (void)ID3D12DescriptorHeap_GetGPUDescriptorHandleForHeapStart(
+        r->srv_heap, &srv_handle);
