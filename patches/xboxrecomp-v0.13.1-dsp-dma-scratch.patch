+static void apu_dsp_scratch_rw(void *opaque, uint8_t *buffer,
+                               uint32_t address, size_t length, bool to_guest)
+{
+    static unsigned int trace_error_count;
+    DSPState *dsp = (DSPState *)opaque;
+    MCPXAPUState *apu;
+    uint32_t sge_base;
+    uint32_t max_sge;
+
+    if (!dsp || !buffer || !length || !dsp->apu_owner) {
+        if (dsp) dsp->dma.error = true;
+        return;
+    }
+    apu = (MCPXAPUState *)dsp->apu_owner;
+    sge_base = apu->regs[dsp->is_gp ? NV_PAPU_GPSADDR : NV_PAPU_EPSADDR];
+    max_sge = apu->regs[dsp->is_gp ? NV_PAPU_GPSMAXSGE : NV_PAPU_EPSMAXSGE];
+
+    while (length) {
+        uint32_t page = address / 0x1000u;
+        uint32_t offset = address % 0x1000u;
+        size_t count = 0x1000u - offset;
+        uint64_t descriptor_address = (uint64_t)sge_base + (uint64_t)page * 8u;
+        uint8_t *descriptor;
+        uint32_t physical_address;
+        uint8_t *guest;
+
+        if (page > max_sge || page >= 0x4000u ||
+            descriptor_address > UINT32_MAX - sizeof(uint32_t)) {
+            if (getenv("RECOMP_APU_DSP_TRACE") && trace_error_count++ < 8u)
+                fprintf(stderr, "[APU-DMA] %s invalid page=%u max=%u SGE=%08X\n",
+                        dsp->is_gp ? "GP" : "EP", page, max_sge, sge_base);
+            dsp->dma.error = true;
+            return;
+        }
+        if (count > length) count = length;
+        descriptor = apu_dsp_resolve_physical(descriptor_address,
+                                               sizeof(uint32_t));
+        if (getenv("RECOMP_APU_DSP_TRACE") && trace_error_count < 8u) {
+            fprintf(stderr,
+                    "[APU-DMA] %s SGE=%08X max=%u page=%u desc=%p value=%08X\n",
+                    dsp->is_gp ? "GP" : "EP", sge_base, max_sge, page,
+                    descriptor, descriptor ? read_le32(descriptor) : 0xFFFFFFFFu);
+            ++trace_error_count;
+        }
+        if (!descriptor || !(physical_address = read_le32(descriptor))) {
+            if (getenv("RECOMP_APU_DSP_TRACE") && trace_error_count++ < 8u)
+                fprintf(stderr, "[APU-DMA] %s missing descriptor=%08llX ptr=%p\n",
+                        dsp->is_gp ? "GP" : "EP",
+                        (unsigned long long)descriptor_address, descriptor);
+            dsp->dma.error = true;
+            return;
+        }
+        if ((uint64_t)physical_address + offset + count > UINT32_MAX) {
+            if (getenv("RECOMP_APU_DSP_TRACE") && trace_error_count++ < 8u)
+                fprintf(stderr, "[APU-DMA] %s overflow page=%08X offset=%X len=%zu\n",
+                        dsp->is_gp ? "GP" : "EP", physical_address, offset, count);
+            dsp->dma.error = true;
+            return;
+        }
+        guest = apu_dsp_resolve_physical(
+            (uint64_t)physical_address + offset, count);
+        if (!guest) {
+            if (getenv("RECOMP_APU_DSP_TRACE") && trace_error_count++ < 8u)
+                fprintf(stderr, "[APU-DMA] %s missing guest page=%08X offset=%X len=%zu\n",
+                        dsp->is_gp ? "GP" : "EP", physical_address, offset, count);
+            dsp->dma.error = true;
+            return;
+        }
+        if (to_guest) memcpy(guest, buffer, count);
+        else memcpy(buffer, guest, count);
+        address += (uint32_t)count;
+        buffer += count;
+        length -= count;
+    }
+}
