+static bool dsp_dma_decode_space(DSPState *dsp, uint32_t address,
+                                 Dsp56300MemSpace *space, uint32_t *offset)
+{
+    if (address < 0x1800u) {
+        *space = DSP56300_MEM_SPACE_X;
+        *offset = address;
+        return address < (dsp->is_gp ? 0x1800u : EP_X_RAM_WORDS);
+    }
+    if (address >= 0x1800u && address < 0x2000u) {
+        *space = DSP56300_MEM_SPACE_Y;
+        *offset = address - 0x1800u;
+        return *offset < (dsp->is_gp ? GP_Y_RAM_WORDS : EP_Y_RAM_WORDS);
+    }
+    if (address >= 0x2800u && address < 0x3800u) {
+        *space = DSP56300_MEM_SPACE_P;
+        *offset = address - 0x2800u;
+        return *offset < DSP_P_RAM_WORDS;
+    }
+    return false;
+}
+
+static bool dsp_dma_range_valid(DSPState *dsp, Dsp56300MemSpace space,
+                                uint32_t offset, uint32_t count)
+{
+    uint32_t size;
+    if (!count) return false;
+    switch (space) {
+    case DSP56300_MEM_SPACE_X:
+        if (dsp->is_gp && offset >= GP_MIXBUF_START &&
+            offset < GP_MIXBUF_START + GP_MIXBUF_WORDS) {
+            size = GP_MIXBUF_START + GP_MIXBUF_WORDS;
+        } else {
+            size = dsp->is_gp ? GP_X_RAM_WORDS : EP_X_RAM_WORDS;
+        }
+        break;
+    case DSP56300_MEM_SPACE_Y:
+        size = dsp->is_gp ? GP_Y_RAM_WORDS : EP_Y_RAM_WORDS;
+        break;
+    case DSP56300_MEM_SPACE_P:
+        size = DSP_P_RAM_WORDS;
+        break;
+    default:
+        return false;
+    }
+    return offset < size && count <= size - offset;
+}
+
+static bool dsp_dma_scratch_copy(DSPState *dsp, uint8_t *buffer,
+                                 size_t length, uint32_t buffer_id,
+                                 uint32_t scratch_base, uint32_t scratch_offset,
+                                 uint32_t scratch_size, bool to_guest,
+                                 uint32_t *updated_offset)
+{
+    if (buffer_id != 0xEu && buffer_id != 0xFu) return false;
+    if (buffer_id == 0xFu) {
+        uint64_t address = (uint64_t)scratch_base + scratch_offset;
+        if (address > UINT32_MAX || !dsp->dma.scratch_rw) return false;
+        dsp->dma.scratch_rw(dsp->dma.rw_opaque, buffer, (uint32_t)address,
+                            length, to_guest);
+        if (updated_offset) *updated_offset = scratch_offset;
+        return !dsp->dma.error;
+    }
+
+    if (!scratch_size || !dsp->dma.scratch_rw) return false;
+    if (scratch_offset >= scratch_size) scratch_offset = 0;
+    while (length) {
+        size_t chunk = scratch_size - scratch_offset;
+        uint64_t address = (uint64_t)scratch_base + scratch_offset;
+        if (chunk > length) chunk = length;
+        if (address > UINT32_MAX) return false;
+        dsp->dma.scratch_rw(dsp->dma.rw_opaque, buffer, (uint32_t)address,
+                            chunk, to_guest);
+        if (dsp->dma.error) return false;
+        buffer += chunk;
+        length -= chunk;
+        scratch_offset += (uint32_t)chunk;
+        if (scratch_offset >= scratch_size) scratch_offset = 0;
+    }
+    if (updated_offset) *updated_offset = scratch_offset;
+    return true;
+}
