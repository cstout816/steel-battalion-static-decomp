+++ b/src/kernel/nv2a_pb_scan.c
@@ -50,6 +50,33 @@ extern void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
 extern void nv2a_pb_exec_report(void);
 static int s_exec_enabled = -1;
 
+/* Trace object selection and DMA/semaphore methods needed to resolve a
+ * title's fence target. This is observational only. */
+static void trace_semaphore_method(uint32_t subch, uint32_t method,
+                                   uint32_t param)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+        enabled = getenv("RECOMP_PB_SEMAPHORE_TRACE") != NULL;
+    if (!enabled)
+        return;
+
+    const char *name = NULL;
+    if (method == 0x0000)
+        name = "SET_OBJECT";
+    else if (method >= 0x0180 && method <= 0x01A8)
+        name = "CONTEXT_DMA";
+    else if (method == 0x1D6C)
+        name = "SET_SEMAPHORE_OFFSET";
+    else if (method == 0x1D70)
+        name = "BACK_END_WRITE_SEMAPHORE_RELEASE";
+    else
+        return;
+
+    fprintf(stderr, "  [PB-SEM] subch %u method 0x%04X %-36s param 0x%08X\n",
+            subch, method, name, param);
+}
+
 static void note(uint32_t subch, uint32_t method)
 {
