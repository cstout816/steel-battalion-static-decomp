++static uint8_t synthetic_physical_ram[0x10000];
++
++static uint8_t *resolve_synthetic_physical(uint64_t address, size_t size)
++{
++    if (address > sizeof(synthetic_physical_ram) ||
++        size > sizeof(synthetic_physical_ram) - (size_t)address) {
++        return NULL;
++    }
++    return synthetic_physical_ram + address;
++}
++
++static int check_word(const char *name,
++                      const DSPState *dsp,
++                      Dsp56300MemSpace space,
++                      uint32_t address,
++                      uint32_t *backing_word,
++                      uint32_t value)
++{
++    dsp56300_write_memory((Dsp56300Jit *)dsp->jit, space, address, value);
++    if (*backing_word != value ||
++        dsp56300_read_memory((const Dsp56300Jit *)dsp->jit, space, address) != value) {
++        fprintf(stderr, "DSP memory-map check failed: %s\n", name);
++        return 0;
++    }
++    return 1;
++}
++
++static int check_mmio_word(const char *name, DSPState *dsp,
++                           uint32_t byte_offset, uint32_t *backing_word,
++                           uint32_t value)
++{
++    uint32_t actual = 0;
++    if (!mcpx_apu_dsp_memory_write(dsp, byte_offset, value) ||
++        *backing_word != (value & 0x00FFFFFFu) ||
++        !mcpx_apu_dsp_memory_read(dsp, byte_offset, &actual) ||
++        actual != (value & 0x00FFFFFFu)) {
++        fprintf(stderr, "DSP guest MMIO check failed: %s\n", name);
++        return 0;
++    }
++    return 1;
++}
