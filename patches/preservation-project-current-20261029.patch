++            } else if (item_size == 2u) {
++                value = ((uint32_t)buffer[i * 2u] |
++                         ((uint32_t)buffer[i * 2u + 1u] << 8)) << 8;
++            } else {
++                value = (uint32_t)buffer[i * 4u] |
++                        ((uint32_t)buffer[i * 4u + 1u] << 8) |
++                        ((uint32_t)buffer[i * 4u + 2u] << 16) |
++                        ((uint32_t)buffer[i * 4u + 3u] << 24);
