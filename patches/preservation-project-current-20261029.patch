++/* Translate guest-visible byte offsets to the DSP's 24-bit word spaces.
++ * False means the access is a peripheral register or an unmapped hole. */
++static bool mmio_word(DSPState *dsp, uint32_t byte_offset,
++                      DspMmioSpace *space, uint32_t *word)
++{
++    if (!dsp || (byte_offset & 3u) != 0) {
++        return false;
++    }
++    if (dsp->is_gp) {
++        if (byte_offset < GP_X_RAM_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_X;
++            *word = byte_offset / 4u;
++        } else if (byte_offset >= 0x5000u &&
++                   byte_offset < 0x5000u + GP_MIXBUF_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_X;
++            *word = GP_MIXBUF_START + (byte_offset - 0x5000u) / 4u;
++        } else if (byte_offset >= 0x6000u &&
++                   byte_offset < 0x6000u + GP_Y_RAM_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_Y;
++            *word = (byte_offset - 0x6000u) / 4u;
++        } else if (byte_offset >= 0xA000u &&
++                   byte_offset < 0xA000u + DSP_P_RAM_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_P;
++            *word = (byte_offset - 0xA000u) / 4u;
++        } else {
++            return false;
++        }
++    } else {
++        if (byte_offset < EP_X_RAM_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_X;
++            *word = byte_offset / 4u;
++        } else if (byte_offset >= 0x6000u &&
++                   byte_offset < 0x6000u + EP_Y_RAM_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_Y;
++            *word = (byte_offset - 0x6000u) / 4u;
++        } else if (byte_offset >= 0xA000u &&
++                   byte_offset < 0xA000u + DSP_P_RAM_WORDS * 4u) {
++            *space = DSP_MMIO_SPACE_P;
++            *word = (byte_offset - 0xA000u) / 4u;
++        } else {
++            return false;
++        }
++    }
++    return true;
++}
++
++static uint32_t *mmio_backing_word(DSPState *dsp,
++                                   DspMmioSpace space,
++                                   uint32_t word)
++{
++    if (dsp->guest_mmio_base) {
++        uint32_t byte_offset;
++        if (space == DSP_MMIO_SPACE_X) {
++            byte_offset = dsp->is_gp && word >= GP_MIXBUF_START
++                    && word < GP_MIXBUF_START + GP_MIXBUF_WORDS
++                ? 0x5000u + (word - GP_MIXBUF_START) * 4u
++                : word * 4u;
++        } else if (space == DSP_MMIO_SPACE_Y) {
++            byte_offset = 0x6000u + word * 4u;
++        } else {
++            byte_offset = 0xA000u + word * 4u;
++        }
++        return (uint32_t *)(dsp->guest_mmio_base + byte_offset);
++    }
++    if (space == DSP_MMIO_SPACE_X) {
++        if (dsp->is_gp && word >= GP_MIXBUF_START &&
++            word < GP_MIXBUF_START + GP_MIXBUF_WORDS) {
++            return &dsp->core.mixbuffer[word - GP_MIXBUF_START];
++        }
++        return &dsp->core.xram[word];
++    }
++    if (space == DSP_MMIO_SPACE_Y) {
++        return &dsp->core.yram[word];
++    }
++    return &dsp->core.pram[word];
++}
++
++bool mcpx_apu_dsp_memory_read(DSPState *dsp, uint32_t byte_offset,
++                              uint32_t *value)
++{
++    DspMmioSpace space;
++    uint32_t word;
++    if (!value || !mmio_word(dsp, byte_offset, &space, &word)) {
++        return false;
++    }
++    *value = *mmio_backing_word(dsp, space, word) & DSP_WORD_MASK;
++    return true;
++}
++
++bool mcpx_apu_dsp_memory_write(DSPState *dsp, uint32_t byte_offset,
++                               uint32_t value)
++{
++    DspMmioSpace space;
++    uint32_t word;
++    if (!mmio_word(dsp, byte_offset, &space, &word)) {
++        return false;
++    }
++    value &= DSP_WORD_MASK;
++#ifdef MCPX_APU_USE_DSP56300
++    if (space == DSP_MMIO_SPACE_P && dsp->jit) {
++        dsp56300_write_memory((Dsp56300Jit *)dsp->jit,
++                              DSP56300_MEM_SPACE_P, word, value);
++    } else {
++        *mmio_backing_word(dsp, space, word) = value;
++    }
++#else
++    *mmio_backing_word(dsp, space, word) = value;
++#endif
++    return true;
++}
