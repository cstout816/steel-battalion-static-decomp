++        if (!dsp_dma_decode_space(dsp, node_address, &node_space, &node_offset) ||
++            !dsp_dma_range_valid(dsp, node_space, node_offset, 7u)) {
++            return false;
++        }
++        for (uint32_t i = 0; i < 7u; ++i) {
++            node[i] = dsp56300_read_memory((Dsp56300Jit *)dsp->jit,
++                                            node_space, node_offset + i);
++        }
++        dsp->dma.next_block = node[0];
++        if ((node[0] & DSP_DMA_NODE_EOL) != 0) dsp->dma.eol = true;
