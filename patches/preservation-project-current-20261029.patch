++static bool scratch_read_scatter_gather(
++    uint32_t sge_base, uint32_t max_sge, uint8_t *dst, size_t len,
++    mcpx_apu_dsp_phys_resolver resolve_physical)
++{
++    uint64_t scratch_address = 0;
++
++    while (len > 0) {
++        uint32_t page_entry = (uint32_t)(scratch_address / DSP_SCRATCH_PAGE_BYTES);
++        uint32_t offset_in_page = (uint32_t)(scratch_address % DSP_SCRATCH_PAGE_BYTES);
++        size_t bytes_to_copy = DSP_SCRATCH_PAGE_BYTES - offset_in_page;
++        uint64_t descriptor_address;
++        uint8_t *descriptor;
++        uint32_t physical_address;
++        uint8_t *source;
++
++        if (bytes_to_copy > len) {
++            bytes_to_copy = len;
++        }
++        if (page_entry > max_sge || page_entry >= DSP_MAX_SGE_ENTRIES) {
++            return false;
++        }
++        descriptor_address = (uint64_t)sge_base + (uint64_t)page_entry * 8u;
++        if (descriptor_address > UINT32_MAX - 4u) {
++            return false;
++        }
++        descriptor = resolve_physical(descriptor_address, sizeof(uint32_t));
++        if (!descriptor) {
++            return false;
++        }
++        physical_address = read_le32(descriptor);
++        /* An unwritten SGE slot reads as zero in the standalone RAM map.
++         * Do not treat that zero-filled table as a valid 2 KiB DSP program:
++         * reset may be released before the title has built its scratch list. */
++        if (physical_address == 0) {
++            return false;
++        }
++        if ((uint64_t)physical_address + offset_in_page > UINT32_MAX ||
++            (uint64_t)physical_address + offset_in_page + bytes_to_copy > UINT32_MAX) {
++            return false;
++        }
++        source = resolve_physical((uint64_t)physical_address + offset_in_page,
++                                  bytes_to_copy);
++        if (!source) {
++            return false;
++        }
++        memcpy(dst, source, bytes_to_copy);
++        dst += bytes_to_copy;
++        len -= bytes_to_copy;
++        scratch_address += bytes_to_copy;
++    }
++    return true;
++}
