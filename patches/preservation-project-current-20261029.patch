++/* Bounded point-in-time snapshot used by the diagnostic watchdog. This is
++ * read-only: the table lock protects slot allocation while atomic reads keep
++ * each owner field individually coherent. The 64-row cap prevents a damaged
++ * or unusually busy run from growing the watchdog record without bound. */
++size_t xbox_CsTraceSnapshot(char* out, size_t capacity)
++{
++    size_t used = 0;
++    size_t i;
++    unsigned emitted = 0;
++    unsigned owned = 0;
++
++    if (!out || capacity == 0)
++        return 0;
++
++    AcquireSRWLockShared(&g_cs_table_lock);
++    for (i = 0; i < XBOX_CS_TABLE_SIZE; ++i) {
++        XBOX_CS_SLOT* slot = &g_cs_table[i];
++        uintptr_t key = slot->key;
++        LONG owner = InterlockedCompareExchange((volatile LONG*)&slot->owner_tid, 0, 0);
++        LONG site = InterlockedCompareExchange((volatile LONG*)&slot->owner_site, 0, 0);
++        LONG depth = InterlockedCompareExchange(&slot->depth, 0, 0);
++
++        if (!key || owner == 0)
++            continue;
++        ++owned;
++        if (emitted >= 64)
++            continue;
++        used += (size_t)snprintf(out + used, capacity - used,
++                "[CS-OWNER] guest=%08X tid=%lu site=%08X depth=%ld\n",
++                (uint32_t)(key - (uintptr_t)g_xbox_mem_offset),
++                (unsigned long)(uint32_t)owner, (uint32_t)site, (long)depth);
++        if (used >= capacity - 1) {
++            used = capacity - 1;
++            break;
++        }
++        ++emitted;
++    }
++    ReleaseSRWLockShared(&g_cs_table_lock);
++
++    if (used < capacity - 1) {
++        used += (size_t)snprintf(out + used, capacity - used,
++                "[CS-OWNER-SNAPSHOT] owned=%u emitted=%u cap=64 dropped=%u\n",
++                owned, emitted, owned > emitted ? owned - emitted : 0);
++        if (used >= capacity)
++            used = capacity - 1;
++    }
++    out[used] = '\0';
++    return used;
++}
