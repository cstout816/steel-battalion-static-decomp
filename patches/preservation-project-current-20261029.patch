++        for (uint32_t i = 0; i < count; ++i) {
++            uint32_t value = dsp56300_read_memory(
++                (Dsp56300Jit *)dsp->jit, space, memory_offset + i);
++            if (item_size == 1u) {
++                buffer[i] = (uint8_t)value;
++            } else if (item_size == 2u) {
++                uint16_t sample = (uint16_t)(value >> 8);
++                buffer[i * 2u] = (uint8_t)sample;
++                buffer[i * 2u + 1u] = (uint8_t)(sample >> 8);
++            } else {
++                buffer[i * 4u] = (uint8_t)value;
++                buffer[i * 4u + 1u] = (uint8_t)(value >> 8);
++                buffer[i * 4u + 2u] = (uint8_t)(value >> 16);
++                buffer[i * 4u + 3u] = (uint8_t)(value >> 24);
++            }
