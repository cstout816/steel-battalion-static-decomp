++bool mcpx_apu_dsp_bootstrap_from_scratch(
++    DSPState *dsp, uint32_t sge_base, uint32_t max_sge,
++    uint32_t program_words, mcpx_apu_dsp_phys_resolver resolve_physical)
++{
++    uint32_t scratch[DSP_BOOTSTRAP_WORDS];
++    size_t scratch_bytes;
++
++    if (!dsp || !resolve_physical || !program_words ||
++        program_words > DSP_BOOTSTRAP_WORDS ||
++        max_sge >= DSP_MAX_SGE_ENTRIES) {
++        return false;
++    }
++    scratch_bytes = (size_t)program_words * sizeof(scratch[0]);
++    if (!scratch_read_scatter_gather(sge_base, max_sge, (uint8_t *)scratch,
++                                     scratch_bytes, resolve_physical)) {
++        return false;
++    }
++    for (uint32_t i = 0; i < program_words; ++i) {
++        if (!mcpx_apu_dsp_memory_write(
++                dsp, 0xA000u + i * 4u, scratch[i] & DSP_WORD_MASK)) {
++            return false;
++        }
++    }
++    mcpx_apu_dsp_sync_program_cache(dsp);
++    return true;
++}
