++    ok &= check_word("GP X first word", &gp, DSP56300_MEM_SPACE_X,
++                     0x0000, (uint32_t *)(guest_ram + 0x0000), 0x12345);
++    ok &= check_word("GP X last word", &gp, DSP56300_MEM_SPACE_X,
++                     0x0FFF, (uint32_t *)(guest_ram + 0x3FFCu), 0x23456);
++    ok &= check_word("GP mixbuffer first word", &gp, DSP56300_MEM_SPACE_X,
++                     0x1400, (uint32_t *)(guest_ram + 0x5000u), 0x34567);
++    ok &= check_word("GP mixbuffer last word", &gp, DSP56300_MEM_SPACE_X,
++                     0x17FF, (uint32_t *)(guest_ram + 0x5FFCu), 0x45678);
++    ok &= check_word("GP Y last word", &gp, DSP56300_MEM_SPACE_Y,
++                     0x07FF, (uint32_t *)(guest_ram + 0x7FFCu), 0x56789);
++    ok &= check_word("GP P last word", &gp, DSP56300_MEM_SPACE_P,
