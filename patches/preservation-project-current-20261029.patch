++void mcpx_apu_dsp_sync_program_cache(DSPState *dsp)
++{
++#ifdef MCPX_APU_USE_DSP56300
++    uint32_t *program;
++    uint64_t hash = UINT64_C(1469598103934665603);
++
++    if (!dsp || !dsp->jit || !dsp->guest_mmio_base) {
++        return;
++    }
++    program = (uint32_t *)(dsp->guest_mmio_base + 0xA000u);
++    for (uint32_t i = 0; i < DSP_P_RAM_WORDS; ++i) {
++        hash ^= program[i] & DSP_WORD_MASK;
++        hash *= UINT64_C(1099511628211);
++    }
++    if (!dsp->guest_program_hash_valid || hash != dsp->guest_program_hash) {
++        dsp56300_invalidate_cache((Dsp56300Jit *)dsp->jit);
++        dsp->guest_program_hash = hash;
++        dsp->guest_program_hash_valid = true;
++    }
++#else
++    (void)dsp;
++#endif
++}
