++
++    if ((control & 1u) != 0 || count == 0 || count > 0x10000u ||
++        (format != 0u && format != 1u && format != 2u && format != 6u) ||
++        (buffer_id != 0xEu && buffer_id != 0xFu) ||
++        count > (SIZE_MAX / item_size) ||
++        !dsp_dma_range_valid(dsp, space, memory_offset, count)) {
