+/* Opt-in synchronization diagnostics: show whether a thread sleeps while it
+ * still owns any guest critical sections, without changing lock behavior. */
+void xbox_CsTraceOwnedLocks(void)
+{
+    unsigned long tid = GetCurrentThreadId();
+    size_t i;
+    for (i = 0; i < XBOX_CS_TABLE_SIZE; ++i) {
+        XBOX_CS_SLOT* slot = &g_cs_table[i];
+        if (slot->key && slot->owner_tid == tid) {
+            fprintf(stderr, "[SYNC]   held-lock guest=%08X site=%08X depth=%ld\n",
+                    (uint32_t)(slot->key - (uintptr_t)g_xbox_mem_offset),
+                    slot->owner_site, slot->depth);
+        }
+    }
+}
