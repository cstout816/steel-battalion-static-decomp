+/* Optional startup synchronization trace. It is deliberately observational:
+ * keep the normal bridge behavior untouched and bound diagnostic output so a
+ * runaway guest cannot fill the disk. */
+static int bridge_sync_trace_enabled(void)
+{
+    static LONG cached = -1;
+    LONG value = InterlockedCompareExchange(&cached, -1, -1);
+    if (value < 0) {
+        const char *setting = getenv("RECOMP_SYNC_TRACE");
+        value = setting && setting[0] && setting[0] != '0';
+        InterlockedCompareExchange(&cached, value, -1);
+    }
+    return value != 0;
+}
+
+static int bridge_sync_trace_allow(void)
+{
+    static volatile LONG lines;
+    return InterlockedIncrement(&lines) <= 4096;
+}
+
+static LONG bridge_sync_trace_delay_number(void)
+{
+    static volatile LONG calls;
+    return InterlockedIncrement(&calls);
+}
