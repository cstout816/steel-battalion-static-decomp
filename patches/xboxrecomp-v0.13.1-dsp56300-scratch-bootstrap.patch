diff --git a/src/apu/apu_dsp56300_bridge.c b/src/apu/apu_dsp56300_bridge.c
index 0c46c33..c43dce5 100644
--- a/src/apu/apu_dsp56300_bridge.c
+++ b/src/apu/apu_dsp56300_bridge.c
@@ -1,8 +1,9 @@
 /*
  * XboxRecomp-owned adapter between the MCPX APU state and the MIT DSP56300 C FFI.
  * The FFI receives stable backing arrays owned by DSPState. This file maps
- * guest GP/EP RAM windows and manages the optional core lifecycle. Firmware
- * bootstrap, DSP cycle scheduling, DMA, and audio generation are not wired.
+ * guest GP/EP RAM windows, loads reset-time programs from scratch SGE pages,
+ * and manages the optional core lifecycle. DSP cycle scheduling, FIFO DMA,
+ * and audio generation are not wired.
  */
 #include "apu_dsp56300_bridge.h"
 
@@ -21,6 +22,9 @@
 #define EP_Y_RAM_WORDS 0x0100u
 #define DSP_P_RAM_WORDS 0x1000u
 #define DSP_WORD_MASK 0x00FFFFFFu
+#define DSP_BOOTSTRAP_WORDS 0x0800u
+#define DSP_SCRATCH_PAGE_BYTES 0x1000u
+#define DSP_MAX_SGE_ENTRIES 0x4000u
 
 typedef enum {
     DSP_MMIO_SPACE_X,
@@ -262,3 +266,85 @@ bool mcpx_apu_dsp_memory_write(DSPState *dsp, uint32_t byte_offset,
 #endif
     return true;
 }
+
+static uint32_t read_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] |
+           ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) |
+           ((uint32_t)p[3] << 24);
+}
+
+static bool scratch_read_scatter_gather(
+    uint32_t sge_base, uint32_t max_sge, uint8_t *dst, size_t len,
+    mcpx_apu_dsp_phys_resolver resolve_physical)
+{
+    uint64_t scratch_address = 0;
+
+    while (len > 0) {
+        uint32_t page_entry = (uint32_t)(scratch_address / DSP_SCRATCH_PAGE_BYTES);
+        uint32_t offset_in_page = (uint32_t)(scratch_address % DSP_SCRATCH_PAGE_BYTES);
+        size_t bytes_to_copy = DSP_SCRATCH_PAGE_BYTES - offset_in_page;
+        uint64_t descriptor_address;
+        uint8_t *descriptor;
+        uint32_t physical_address;
+        uint8_t *source;
+
+        if (bytes_to_copy > len) {
+            bytes_to_copy = len;
+        }
+        if (page_entry > max_sge || page_entry >= DSP_MAX_SGE_ENTRIES) {
+            return false;
+        }
+        descriptor_address = (uint64_t)sge_base + (uint64_t)page_entry * 8u;
+        if (descriptor_address > UINT32_MAX - 4u) {
+            return false;
+        }
+        descriptor = resolve_physical(descriptor_address, sizeof(uint32_t));
+        if (!descriptor) {
+            return false;
+        }
+        physical_address = read_le32(descriptor);
+        if ((uint64_t)physical_address + offset_in_page > UINT32_MAX ||
+            (uint64_t)physical_address + offset_in_page + bytes_to_copy > UINT32_MAX) {
+            return false;
+        }
+        source = resolve_physical((uint64_t)physical_address + offset_in_page,
+                                  bytes_to_copy);
+        if (!source) {
+            return false;
+        }
+        memcpy(dst, source, bytes_to_copy);
+        dst += bytes_to_copy;
+        len -= bytes_to_copy;
+        scratch_address += bytes_to_copy;
+    }
+    return true;
+}
+
+bool mcpx_apu_dsp_bootstrap_from_scratch(
+    DSPState *dsp, uint32_t sge_base, uint32_t max_sge,
+    uint32_t program_words, mcpx_apu_dsp_phys_resolver resolve_physical)
+{
+    uint32_t scratch[DSP_BOOTSTRAP_WORDS];
+    size_t scratch_bytes;
+
+    if (!dsp || !resolve_physical || !program_words ||
+        program_words > DSP_BOOTSTRAP_WORDS ||
+        max_sge >= DSP_MAX_SGE_ENTRIES) {
+        return false;
+    }
+    scratch_bytes = (size_t)program_words * sizeof(scratch[0]);
+    if (!scratch_read_scatter_gather(sge_base, max_sge, (uint8_t *)scratch,
+                                     scratch_bytes, resolve_physical)) {
+        return false;
+    }
+    for (uint32_t i = 0; i < program_words; ++i) {
+        if (!mcpx_apu_dsp_memory_write(
+                dsp, 0xA000u + i * 4u, scratch[i] & DSP_WORD_MASK)) {
+            return false;
+        }
+    }
+    mcpx_apu_dsp_sync_program_cache(dsp);
+    return true;
+}

