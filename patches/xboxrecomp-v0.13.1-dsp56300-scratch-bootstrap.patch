+static int check_scratch_bootstrap(void)
+{
+    DSPState dsp = {0};
+    uint8_t guest_ram[0xE000] = {0};
+    uint32_t *table = (uint32_t *)(synthetic_physical_ram + 0x1000u);
+    uint32_t *page0 = (uint32_t *)(synthetic_physical_ram + 0x3000u);
+    uint32_t *page1 = (uint32_t *)(synthetic_physical_ram + 0x5000u);
+    int ok = 1;
+
+    memset(synthetic_physical_ram, 0, sizeof(synthetic_physical_ram));
+    table[0] = 0x3000u;
+    table[1] = 0;
+    table[2] = 0x5000u;
+    table[3] = 0;
+    page0[0] = 0xAB112233u;
+    page0[0x3FF] = 0xCD223344u;
+    page1[0] = 0xEF334455u;
+    page1[0x3FF] = 0xAA445566u;
+
+    dsp.is_gp = true;
+    dsp.guest_mmio_base = guest_ram;
+    if (!mcpx_apu_dsp_engine_init(&dsp)) {
+        fprintf(stderr, "DSP bootstrap test engine creation failed\n");
+        return 0;
+    }
+    if (!mcpx_apu_dsp_bootstrap_from_scratch(
+            &dsp, 0x1000u, 1u, 0x0800u, resolve_synthetic_physical)) {
+        fprintf(stderr, "DSP scatter/gather scratch bootstrap failed\n");
+        ok = 0;
+    } else if (((uint32_t *)(guest_ram + 0xA000u))[0] != 0x00112233u ||
+               ((uint32_t *)(guest_ram + 0xA000u))[0x3FF] != 0x00223344u ||
+               ((uint32_t *)(guest_ram + 0xA000u))[0x400] != 0x00334455u ||
+               ((uint32_t *)(guest_ram + 0xA000u))[0x7FF] != 0x00445566u) {
+        fprintf(stderr, "DSP bootstrap did not mask/copy across SGE pages\n");
+        ok = 0;
+    }
+    if (mcpx_apu_dsp_bootstrap_from_scratch(
+            &dsp, 0x1000u, 0u, 0x0800u, resolve_synthetic_physical)) {
+        fprintf(stderr, "DSP bootstrap accepted an incomplete SGE table\n");
+        ok = 0;
+    }
+    mcpx_apu_dsp_engine_destroy(&dsp);
+    return ok;
+}
+
 int main(void)
 {
-    if (!check_gp_map() || !check_ep_map()) {
+    if (!check_gp_map() || !check_ep_map() || !check_scratch_bootstrap()) {
