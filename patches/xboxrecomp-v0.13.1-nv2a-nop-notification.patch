+void nv2a_pgraph_notify(uint32_t subchannel, uint32_t method,
+                        uint32_t parameter)
+{
+    NV2AState *d = g_nv2a;
+    uint32_t channel_id;
+    uint32_t trapped_addr;
+
+    if (!d || parameter == 0)
+        return;
+
+    qemu_mutex_lock(&d->pgraph.lock);
+    channel_id = (d->pgraph.regs[NV_PGRAPH_CTX_USER]
+                  & NV_PGRAPH_CTX_USER_CHID) >> 24;
+    trapped_addr = ((channel_id << 20) & NV_PGRAPH_TRAPPED_ADDR_CHID)
+                 | ((subchannel << 16) & NV_PGRAPH_TRAPPED_ADDR_SUBCH)
+                 | (method & NV_PGRAPH_TRAPPED_ADDR_MTHD);
+    d->pgraph.regs[NV_PGRAPH_TRAPPED_ADDR] = trapped_addr;
+    d->pgraph.regs[NV_PGRAPH_TRAPPED_DATA_LOW] = parameter;
+    d->pgraph.regs[NV_PGRAPH_NSOURCE] = NV_PGRAPH_NSOURCE_NOTIFICATION;
+    d->pgraph.pending_interrupts |= NV_PGRAPH_INTR_ERROR;
+    nv2a_update_irq(d);
+
+    /* The NV097 NOP notification is a synchronous software method: the
+     * command processor stays here until the guest ISR acknowledges PGRAPH. */
+    while (d->pgraph.pending_interrupts & NV_PGRAPH_INTR_ERROR)
+        qemu_cond_wait(&d->pgraph.interrupt_cond, &d->pgraph.lock);
+    qemu_mutex_unlock(&d->pgraph.lock);
 }
 
