+/* Resolve a semaphore context the way PFIFO/PGRAPH do: handle -> RAMHT entry
+ * -> instance in PRAMIN -> DMA descriptor -> physical-memory target. The
+ * aperture is mapped as RAM in this runtime, so this reads the BIOS/D3D
+ * structures without pretending to emulate the rest of NV2A. */
+static int semaphore_target(uint32_t handle, uint32_t offset,
+                            uint32_t *guest_va, uint32_t *instance_out,
+                            uint32_t *flags_out, uint32_t *limit_out,
+                            uint32_t *frame_out, const char **why)
+{
+    const uint32_t ramin_offset = 0x700000u;
+    const uint32_t ramht_reg_offset = 0x2210u;
+    const uint32_t ramht_bytes = 0x1000u;
+    const uint32_t ramht_slots = ramht_bytes / 8u;
+    const uint32_t max_probes = 128u;
+    const uint8_t *nv2a = (const uint8_t *)((uintptr_t)xbox_GetMemoryOffset()
+                                            + 0xFD000000u);
+    const uint32_t *ramin;
+    uint32_t base, slot, instance, context = 0;
+    uint32_t flags, limit, frame, physical;
+    uint64_t end;
+    int found = 0;
+
+    {
+        uint32_t configured = *(const uint32_t *)(nv2a + ramht_reg_offset);
+        uint32_t size_code = (configured >> 24) & 3u;
+        /* RAMHT size code 3 is the Xbox BIOS 4 KB table used by the guest. */
+        if (size_code != 3u) {
+            *why = "unsupported RAMHT size";
+            return 0;
+        }
+        base = (configured & 0xFFFFu) << 8;
+    }
+    if ((uint64_t)base + ramht_bytes > 0x100000u) {
+        *why = "RAMHT outside PRAMIN";
+        return 0;
+    }
+    ramin = (const uint32_t *)(nv2a + ramin_offset);
+
+    /* With the Xbox BIOS setting, a handle below 2048 hashes directly to
+     * its handle value; the configured search depth permits 128 probes. */
+    slot = handle & (ramht_slots - 1u);
+    for (uint32_t probe = 0; probe < max_probes; probe++) {
+        uint32_t entry = (base / 4u) + slot * 2u;
+        uint32_t entry_handle = ramin[entry];
+        context = ramin[entry + 1u];
+        if ((context & 0x80000000u) && entry_handle == handle) {
+            found = 1;
+            break;
+        }
+        slot = (slot + 1u) & (ramht_slots - 1u);
+    }
+    if (!found) {
+        *why = "RAMHT handle not found";
+        return 0;
+    }
+    /* NV4+ uses the RAMHT engine field only when binding method 0. For DMA
+     * methods such as semaphore release, object suitability comes from the
+     * descriptor class below; valid title entries may use the SW engine bits. */
+    instance = (context & 0x0000FFFFu) << 4;
+    if ((uint64_t)instance + 16u > 0x100000u) {
+        *why = "DMA descriptor outside PRAMIN";
+        return 0;
+    }
+    {
+        const uint32_t *dma = ramin + instance / 4u;
+        flags = dma[0];
+        limit = dma[1];
+        frame = dma[2];
+    }
+    if ((flags & 0xFFFu) != 0x03Du) {
+        *why = "DMA object is not a semaphore";
+        return 0;
+    }
+    if ((flags & 0x00030000u) != 0x00020000u) {
+        *why = "semaphore DMA target is not PCI memory";
+        return 0;
+    }
+    /* NV2A treats the DMA limit as an exclusive address: reaching it faults.
+     * Require all four bytes of the release word to remain below that limit. */
+    if ((offset & 3u) || offset >= limit
+        || limit - offset < sizeof(uint32_t)) {
+        *why = "semaphore offset exceeds DMA limit";
+        return 0;
+    }
+    physical = (frame & 0xFFFFF000u) | (flags & 0xFFF00000u);
+    end = (uint64_t)physical + offset + sizeof(uint32_t);
+    if (end > XBOX_CONTIG_SIZE || end < physical) {
+        *why = "semaphore physical address outside Xbox RAM";
+        return 0;
+    }
+    *guest_va = XBOX_CONTIG_BASE + physical + offset;
+    *instance_out = instance;
+    *flags_out = flags;
+    *limit_out = limit;
+    *frame_out = frame;
+    *why = "ok";
+    return 1;
+}
