+void nv2a_pb_exec_packet(uint32_t subch, uint32_t method,
+                         const uint32_t *params, uint32_t count, int noninc)
+{
+    uint32_t i;
+    for (i = 0; i < count; i++) {
+        const uint32_t current = noninc ? method : method + i * 4u;
+        nv2a_pb_exec_method_at(subch, current, params[i],
+                               s_pb_packet_header_va,
+                               s_pb_packet_header_va + 4u + i * 4u);
+    }
+}
+
+/* The DMA walker may resume a packet that was split across two DMA_PUT
+ * updates. Preserve the original packet header while passing each fetched
+ * parameter independently to the existing method executor. */
+void nv2a_pb_exec_method_at(uint32_t subch, uint32_t method, uint32_t param,
+                           uint32_t header_va, uint32_t parameter_va)
+{
+    s_pb_packet_header_va = header_va;
+    s_pb_parameter_va = parameter_va;
+    s_pb_current_method = method;
+    nv2a_pb_exec_method(subch, method, param);
+}
