@@ -3404,6 +3404,15 @@ static void peek_chain(void)
     fflush(stderr);
 }
 
+void nv2a_pb_exec_packet(uint32_t subch, uint32_t method,
+                         const uint32_t *params, uint32_t count, int noninc)
+{
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t current = noninc ? method : method + i * 4u;
+        nv2a_pb_exec_method(subch, current, params[i]);
+    }
+}
